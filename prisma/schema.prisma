// TradeJournal — Prisma schema (Prisma ORM v7, driver-adapter architecture)
// Connection lives in prisma.config.ts + src/lib/prisma.ts (via @prisma/adapter-neon), not here.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth.js required models (PrismaAdapter contract) ───────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String? // avatar
  coverImage    String?
  bio           String? // short profile bio, shown on the public profile page
  password      String? // bcrypt hash, only used by the Credentials provider

  username        String?  @unique // lowercase, set via /journal/settings — null until user picks one
  isPublicProfile Boolean  @default(false)

  accounts        Account[]
  sessions        Session[]
  tradingAccounts TradingAccount[]
  trades          Trade[]
  tags            Tag[]
  dayPlans        DayPlan[]
  following       Follow[] @relation("Follower") // Follow rows where I'm the one following -> people I follow
  followers       Follow[] @relation("Followed") // Follow rows where I'm the target -> people who follow me

  createdAt DateTime @default(now())

  @@map("users")
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Followed", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId]) // powers "who follows this user" lookups/counts
  @@map("follows")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── Domain enums ────────────────────────────────────────────────────────────

enum AssetClass {
  STOCK
  FOREX
  CRYPTO
  FUTURES
  OPTIONS
  INDEX
}

enum Direction {
  LONG
  SHORT
}

enum TradingAccountType {
  LIVE
  DEMO
  PROP_FIRM
}

enum TagCategory {
  CHART_PATTERN
  CANDLESTICK
  INDICATOR
  SMC
  CONTEXT
  MISTAKE
  EMOTION
}

// ─── Domain models ───────────────────────────────────────────────────────────

model TradingAccount {
  id              String             @id @default(cuid())
  userId          String
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  broker          String?
  type            TradingAccountType
  startingBalance Decimal            @db.Decimal(14, 2)

  trades    Trade[]
  createdAt DateTime @default(now())

  @@map("trading_accounts")
}

model Trade {
  id               String         @id @default(cuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tradingAccountId String
  tradingAccount   TradingAccount @relation(fields: [tradingAccountId], references: [id], onDelete: Cascade)

  symbol     String
  assetClass AssetClass
  direction  Direction

  entryAt DateTime
  exitAt  DateTime?

  entryPrice Decimal  @db.Decimal(18, 6)
  exitPrice  Decimal? @db.Decimal(18, 6)
  quantity   Decimal  @db.Decimal(18, 6)

  stopLoss   Decimal? @db.Decimal(18, 6)
  target     Decimal? @db.Decimal(18, 6)
  exitReason String?

  riskAmount Decimal? @db.Decimal(14, 2)
  plannedRR  Decimal? @db.Decimal(6, 2)
  realizedR  Decimal? @db.Decimal(6, 2)

  grossPnl Decimal? @db.Decimal(14, 2)
  fees     Decimal? @db.Decimal(14, 2)
  netPnl   Decimal? @db.Decimal(14, 2)

  setupGrade       String?
  followedPlan     Boolean?
  confidenceRating Int? // 1–10, filled pre-outcome (Trade Plan)
  reflection       String? // free-text post-trade note

  // Per-asset-class flexible fields (options strike/expiry, futures contract month, etc.)
  extra Json?

  images TradeImage[]
  tags   TradeTag[]

  isPrivate Boolean @default(false) // excludes this trade from the owner's public profile, if they have one

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, entryAt])
  @@index([userId, symbol])
  @@map("trades")
}

model TradeImage {
  id      String @id @default(cuid())
  tradeId String
  trade   Trade  @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  url  String // Cloudflare R2 object URL
  kind String? // entry | exit | context

  createdAt DateTime @default(now())

  @@map("trade_images")
}

model Tag {
  id       String      @id @default(cuid())
  userId   String
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name     String
  category TagCategory

  trades TradeTag[]

  @@unique([userId, name])
  @@map("tags")
}

model TradeTag {
  tradeId String
  trade   Trade  @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  tagId   String
  tag     Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([tradeId, tagId])
  @@map("trade_tags")
}

model DayPlan {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  date        DateTime @db.Date
  sleepScore  Int?
  stressLevel Int?
  mood        String?
  notes       String?

  @@unique([userId, date])
  @@map("day_plans")
}
