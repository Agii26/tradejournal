# Copy to .env.local for development. In Vercel, set these under
# Project Settings → Environment Variables instead.

# --- Database (Neon) ---
# Pooled connection — used by the running app via @prisma/adapter-neon (src/lib/prisma.ts)
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require"
# Direct (unpooled) connection — used by the Prisma CLI only (migrate/studio), see prisma.config.ts
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require"

# --- Auth.js ---
# Generate with: npx auth secret
AUTH_SECRET=""

# --- Cloudflare R2 (trade screenshot uploads) ---
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL="https://pub-xxxxxxxx.r2.dev"
